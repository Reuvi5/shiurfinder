{
  "name": "shiurfinder",
  "private": true,
  "version": "0.1.0",
  "description": "Live shiurim on a map. MCON 357 team project.",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:deploy": "npm run db:deploy --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:studio": "npm run db:studio --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
