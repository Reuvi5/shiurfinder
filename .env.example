# Copy to .env and fill in. NEVER commit .env.
# Each of us keeps our own .env locally.

# ---------- Database ----------
# Local dev (docker compose up):
DATABASE_URL="postgresql://shiurfinder:localdevpassword@localhost:5432/shiurfinder?schema=public"

# AWS RDS (shared dev DB) — paste the endpoint from the RDS console:
# DATABASE_URL="postgresql://shiurfinder:PASSWORD@shiurfinder-db.XXXXXXXX.us-east-1.rds.amazonaws.com:5432/shiurfinder?schema=public&sslmode=require"

# ---------- Server ----------
PORT=3000
NODE_ENV=development
# Where the website runs, for CORS
WEB_ORIGIN="http://localhost:5173"

# ---------- Google Maps ----------
# Server-side key: Geocoding API. Restrict by IP.
GOOGLE_MAPS_SERVER_KEY=""

# ---------- Website (Vite — anything VITE_* is PUBLIC, never put secrets here) ----------
# Browser key: Maps JavaScript API + Places API. Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_BROWSER_KEY=""
VITE_API_URL="http://localhost:3001"
