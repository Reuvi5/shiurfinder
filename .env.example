# Copy this file to .env and fill it in:  cp .env.example .env
# Never commit .env. It holds the database password.

# ---------- Database ----------
# Shared AWS database (what everyone uses day to day).
# Replace PASSWORD; ask Reuvi for it, and send him your IP (curl -4 ifconfig.me)
# so he can let you through the firewall.
DATABASE_URL="postgresql://shiurfinder:PASSWORD@shiurfinder-db.c2hk8ucusgbx.us-east-1.rds.amazonaws.com:5432/shiurfinder?schema=public&sslmode=require"

# Local Docker database: only needed to change the schema (README, "Changing the database").
# Start it with `npm run db:up`, then use this line instead of the one above:
# DATABASE_URL="postgresql://shiurfinder:localdevpassword@localhost:5432/shiurfinder?schema=public"

# SQL tests (`npm run test:db`): their own database in the local Docker container,
# never the shared one. Create it once first (README, "Tests").
TEST_DATABASE_URL="postgresql://shiurfinder:localdevpassword@localhost:5432/shiurfinder_test?schema=public"

# ---------- Server ----------
PORT=3000
NODE_ENV=development
# The website's address, so the browser is allowed to call the server.
WEB_ORIGIN="http://localhost:5173"

# ---------- Login (Better Auth) ----------
# Signs the login cookie. Any long random text: node -e "console.log(crypto.randomUUID())"
# Optional on your computer; the real server won't start without it.
BETTER_AUTH_SECRET=""
# The server's own address. Must match PORT above.
BETTER_AUTH_URL="http://localhost:3000"
# "Continue with Google" (optional). Ask Oriel for these two; never commit them.
# Without them the Google button says it isn't available, and email still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Google Maps ----------
# Server key: Geocoding API. Restrict by IP. Server only.
GOOGLE_MAPS_SERVER_KEY=""

# ---------- Website ----------
# Anything starting with VITE_ is sent to the browser and is PUBLIC. No secrets here.
# Browser key: Maps JavaScript API + Places API. Restrict to localhost:5173.
VITE_GOOGLE_MAPS_BROWSER_KEY=""
# Map ID (vector map). Public. Without a real one, the pins don't show.
VITE_GOOGLE_MAPS_MAP_ID="dee9671b32faba7bbe388813"
# Where the server runs. Must match PORT above.
VITE_API_URL="http://localhost:3000"
