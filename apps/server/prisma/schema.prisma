// ShiurFinder database schema.
// Mirrors Figure 2 of the Software Design Document.
//
// Note on PostGIS: Prisma has no native geography type, so Publisher.location is
// declared Unsupported(). Prisma still creates and migrates the column, we just
// can't read or filter it through the Prisma client — distance queries are raw
// SQL in map.service.ts, which is what the design doc calls for.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

// ---------------------------------------------------------------- enums

enum PublisherType {
  SHUL
  MAGGID_SHIUR
}

enum TeamRole {
  ADMIN // the publisher itself
  DELEGATE // gabbai, talmid — can post on its behalf
}

enum ShiurKind {
  WEEKLY // repeats on set days
  FEATURED // one-time
}

enum OccurrenceStatus {
  ON
  CHANGED
  REPORTED // someone reported it isn't happening; not yet confirmed
  CANCELLED
}

enum ReportStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

enum SaveScope {
  ONE_DATE
  EVERY_WEEK
}

// ---------------------------------------------------------------- publishers & shiurim

model Publisher {
  id        String        @id @default(cuid())
  type      PublisherType
  name      String
  // Shul address. A maggid shiur may have none of their own.
  address   String?
  city      String?
  state     String?
  zip       String?
  contact   String?
  imageUrl  String? // S3 key: logos/ or photos/
  bio       String? // maggid shiur
  // A moderator must approve before anything this publisher posts goes public (NFR-4).
  approved  Boolean       @default(false)
  // PostGIS geography(Point, 4326). Set by the geocoder when the address is saved.
  // Longitude first: ST_MakePoint(lng, lat).
  location  Unsupported("geography(Point, 4326)")?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  rooms          Room[]
  teamMembers    TeamMember[]
  shiurimAsShul  Shiur[]      @relation("ShulShiurim")
  shiurimAsRav   Shiur[]      @relation("MaggidShiurim")
  follows        Follow[]

  @@index([approved, type])
  @@index([name])
}

model Room {
  id          String @id @default(cuid())
  publisherId String
  name        String // "Main Beis Medrash", "Social Hall"

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  shiurim   Shiur[]

  @@unique([publisherId, name])
}

model TeamMember {
  id          String   @id @default(cuid())
  userId      String
  publisherId String
  role        TeamRole @default(DELEGATE)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([userId, publisherId])
}

model Shiur {
  id          String    @id @default(cuid())
  kind        ShiurKind
  title       String
  description String?

  // Where it happens and who says it. Either may be null, never both.
  shulId        String?
  maggidShiurId String?
  roomId        String?

  topicId    String?
  languageId String?
  audienceId String?

  // WEEKLY: which days it repeats on (0 = Sunday) and the start time as "HH:mm".
  // FEATURED: both null, the single date lives on its one Occurrence.
  daysOfWeek Int[]   @default([])
  startTime  String?
  durationMinutes Int? @default(60)

  flyerUrl  String? // S3 key: flyers/
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shul        Publisher? @relation("ShulShiurim", fields: [shulId], references: [id], onDelete: Cascade)
  maggidShiur Publisher? @relation("MaggidShiurim", fields: [maggidShiurId], references: [id], onDelete: SetNull)
  room        Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  topic       Topic?     @relation(fields: [topicId], references: [id])
  language    Language?  @relation(fields: [languageId], references: [id])
  audience    Audience?  @relation(fields: [audienceId], references: [id])

  occurrences   Occurrence[]
  savedShiurim  SavedShiur[]
  changeHistory ChangeHistory[]

  @@index([shulId])
  @@index([maggidShiurId])
  @@index([kind])
}

// One dated instance of a shiur. A weekly shiur gets rows generated 8 weeks out
// by a nightly job; a featured shiur has exactly one.
model Occurrence {
  id       String           @id @default(cuid())
  shiurId  String
  startsAt DateTime // stored UTC, displayed New York
  endsAt   DateTime?
  roomId   String? // overrides the shiur's room for this date only
  status   OccurrenceStatus @default(ON)
  reason   String? // why it changed or was cancelled

  shiur   Shiur        @relation(fields: [shiurId], references: [id], onDelete: Cascade)
  reports Report[]
  saves   SavedShiur[]

  @@unique([shiurId, startsAt])
  @@index([startsAt, status])
}

// ---------------------------------------------------------------- lists (NFR-6: editable without a code change)

model Topic {
  id     String  @id @default(cuid())
  name   String  @unique
  sort   Int     @default(0)
  shiurim Shiur[]
}

model Language {
  id      String  @id @default(cuid())
  name    String  @unique
  sort    Int     @default(0)
  shiurim Shiur[]
}

model Audience {
  id      String  @id @default(cuid())
  name    String  @unique
  sort    Int     @default(0)
  shiurim Shiur[]
}

// ---------------------------------------------------------------- users

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  // Better Auth owns the password/session tables; we don't model them here.
  homeAddress   String? // optional, private (NFR-5)
  isModerator   Boolean  @default(false)
  darkMode      Boolean  @default(false)
  // Which alert types they want
  alertNewShiur   Boolean @default(true)
  alertChanged    Boolean @default(true)
  alertCancelled  Boolean @default(true)
  alertReminders  Boolean @default(true)
  snsTopicArn     String? // their own SNS topic for email alerts
  createdAt     DateTime @default(now())

  teamMemberships TeamMember[]
  savedShiurim    SavedShiur[]
  follows         Follow[]
  reports         Report[]
  pushSubscriptions PushSubscription[]
  sentAlerts      SentAlert[]
  changes         ChangeHistory[]
  topicsLiked     UserTopic[]
}

model UserTopic {
  userId  String
  topicId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
}

model SavedShiur {
  id           String    @id @default(cuid())
  userId       String
  shiurId      String
  occurrenceId String? // set when scope is ONE_DATE
  scope        SaveScope @default(EVERY_WEEK)
  createdAt    DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiur      Shiur       @relation(fields: [shiurId], references: [id], onDelete: Cascade)
  occurrence Occurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([userId, shiurId, occurrenceId])
}

model Follow {
  id          String   @id @default(cuid())
  userId      String
  publisherId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([userId, publisherId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- reports, history, alerts

model Report {
  id           String       @id @default(cuid())
  occurrenceId String
  reportedById String
  reason       String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  reportedBy User       @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([status])
}

model ChangeHistory {
  id        String   @id @default(cuid())
  shiurId   String
  changedById String?
  summary   String // "created", "time changed 8:00 -> 8:30", "cancelled 2026-12-02"
  createdAt DateTime @default(now())

  shiur     Shiur @relation(fields: [shiurId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([shiurId, createdAt])
}

// So the same alert never goes out twice.
model SentAlert {
  id           String   @id @default(cuid())
  userId       String
  occurrenceId String?
  kind         String // "new" | "changed" | "cancelled" | "reminder"
  sentAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, occurrenceId, kind])
}
